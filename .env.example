# 服务器
PORT=3000
DATA_DIR=./data

# 认证（务必替换示例值，勿提交真实 .env）
# ADMIN_PASSWORD 用于首次登录和旧版密码记录的本地恢复；后台修改密码后会安全地持久化保存。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 仅用于签发登录会话（至少 32 个随机字符）；轮换它会使已登录会话失效，但不会重置新版后台密码。
SESSION_SECRET=please-replace-with-a-random-32plus-char-string
# 公开访问请通过 HTTPS，并将其设为 true。
COOKIE_SECURE=false

# IP 分类
# ipdata.co：机房 IP / ISP 住宅 IP 的判定来源（asn.type + company.type），
# 免费额度 1500 次/天。支持多个 Key（逗号分隔）轮换叠加额度，用尽的 Key 自动跳过。
# 也可以在网页「系统设置 → IP 分类」里增删，设置页的 Key 排在环境变量之前。
IPDATA_API_KEY=key-one,key-two
IPINFO_TOKEN=your-ipinfo-token

# 外部 API
API_KEY=your-api-key-for-external-access

# 代理检测
# 内置检测（默认启用，无需外部服务）
TEST_URL=http://httpbin.org/ip
TEST_TIMEOUT=10000
# 外部测试服务（可选，配置后优先使用）
TESTER_URL=
TESTER_SECRET=

# 全库双来源检测：经代理出口获取 ISP/机房/移动信息
ISPINFO_API_URL=https://ispinfo.io/api/ip
ISPINFO_TIMEOUT=10000
# sing-box 本地 SOCKS 隧道启动超时（毫秒），用于 Hysteria2/VLESS/VMess/Trojan/SS
SINGBOX_START_TIMEOUT=10000

# Cron
CRON_SCHEDULE=*/10 * * * *
CHECK_INTERVAL=600
AUTO_CLASSIFY=true
