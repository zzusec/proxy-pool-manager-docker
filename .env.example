# 服务器
PORT=3000
DATA_DIR=./data

# 认证
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=please-replace-with-a-random-32plus-char-string
COOKIE_SECURE=false

# IP 分类
IPINFO_TOKEN=your-ipinfo-token

# 外部 API
API_KEY=your-api-key-for-external-access

# 代理检测
# 内置检测（默认启用，无需外部服务）
TEST_URL=http://httpbin.org/ip
TEST_TIMEOUT=10000
# 外部测试服务（可选，配置后优先使用）
TESTER_URL=
TESTER_SECRET=

# Cron
CRON_SCHEDULE=*/10 * * * *
CHECK_INTERVAL=600
AUTO_CLASSIFY=true
