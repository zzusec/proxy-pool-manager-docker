# 服务器
PORT=3000
DATA_DIR=./data

# 认证
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=please-replace-with-a-random-32plus-char-string
COOKIE_SECURE=false

# IP 分类
# ipdata.co：机房 IP / ISP 住宅 IP 的判定来源（asn.type + company.type），
# 免费额度 1500 次/天。也可以在网页「系统设置 → IP 分类」里填，设置项优先于此处。
IPDATA_API_KEY=your-ipdata-api-key
IPINFO_TOKEN=your-ipinfo-token

# 外部 API
API_KEY=your-api-key-for-external-access

# 代理检测
# 内置检测（默认启用，无需外部服务）
TEST_URL=http://httpbin.org/ip
TEST_TIMEOUT=10000
# 外部测试服务（可选，配置后优先使用）
TESTER_URL=
TESTER_SECRET=

# 全库双来源检测：经代理出口获取 ISP/机房/移动信息
ISPINFO_API_URL=https://ispinfo.io/api/ip
ISPINFO_TIMEOUT=10000
# sing-box 本地 SOCKS 隧道启动超时（毫秒），用于 Hysteria2/VLESS/VMess/Trojan/SS
SINGBOX_START_TIMEOUT=10000

# Cron
CRON_SCHEDULE=*/10 * * * *
CHECK_INTERVAL=600
AUTO_CLASSIFY=true
